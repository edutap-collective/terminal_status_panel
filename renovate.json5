{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
  ],
  // The runtime dependencies carry tested lower bounds and no upper ones, and
  // no lock file is committed. Renovate deliberately does not move those lower
  // bounds: raising a floor is a claim that the older version is no longer
  // supported, and the only evidence for that is a red `minimum-deps` job --
  // which is exactly the signal a bot bumping the floor would erase. Floors
  // move by hand, with the measurement written into the comment beside them.
  //
  // What is worth watching here is the pinned tooling: the ruff
  // floor-and-ceiling in pyproject, the hook revisions in
  // .pre-commit-config.yaml, and the GitHub Actions versions.
  enabledManagers: ["github-actions", "pre-commit", "pep621"],
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      // One PR a week rather than one per action: these move often and each
      // bump costs a full matrix run across four interpreters and a FreeBSD VM.
      schedule: ["before 6am on monday"],
    },
  ],
}
